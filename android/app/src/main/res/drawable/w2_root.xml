<?xml version="1.0" encoding="utf-8"?>
<!-- lo sfondo dell'app: nero prugna con il bagliore rosso in alto -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#0B0810" /><corners android:radius="28dp" /></shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:gradientRadius="220dp" android:centerX="0.5" android:centerY="0" android:startColor="#47DC283C" android:endColor="#000B0810" />
        <corners android:radius="28dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="28dp" /><stroke android:width="1dp" android:color="#17FFFFFF" /></shape></item>
</layer-list>
