    <item><shape android:shape="rectangle">
        <gradient android:type="radial" android:gradientRadius="240dp" android:centerX="0.85" android:centerY="0.2" android:startColor="#5A1C2A" android:centerColor="#3A121D" android:endColor="#1E0C14" />
