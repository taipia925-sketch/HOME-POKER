<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@drawable/w2_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">
        <ImageView
            android:id="@+id/ava"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/w2_ava_8" />
        <TextView
            android:id="@+id/initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/bricolage_heavy"
            android:shadowColor="#80000000"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="120dp"
                android:text="Marco"
                android:textColor="#F7F3EA"
                android:textSize="15sp"
                android:fontFamily="@font/is_bold" />
            <TextView
                android:id="@+id/due"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/w2_due"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="40 € da pagare"
                android:textColor="#FF8A80"
                android:textSize="10sp"
                android:fontFamily="@font/is_semibold" />
        </LinearLayout>
        <TextView
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="3 ingressi · 60 €"
            android:textColor="#A4B0A8"
            android:textSize="12sp"
            android:fontFamily="@font/is_regular" />
    </LinearLayout>
    <TextView
        android:id="@+id/btn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="92dp"
        android:background="@drawable/w2_rebuy"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="+ Re-buy"
        android:textColor="#7CF5B0"
        android:textSize="14sp"
        android:fontFamily="@font/is_bold" />
</LinearLayout>
</FrameLayout>
