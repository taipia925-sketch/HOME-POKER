<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w2_hero" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/w2_dot" />
            <TextView
                android:id="@+id/label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="IN CORSO · BURCIONE"
                android:textColor="#E0FFFFFF"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:fontFamily="@font/is_bold" />
            <TextView
                android:id="@+id/chat"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:background="@drawable/w2_status"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/is_bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="140,00 €"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:letterSpacing="-0.03"
            android:fontFamily="@font/bricolage_heavy" />
        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ti devono 65 €"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/is_semibold" />
    </LinearLayout>
</FrameLayout>
