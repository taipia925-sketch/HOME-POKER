<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_rail"
    android:padding="4dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_felt"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/table"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="♠&#xFE0E; BURCIONE"
            android:textColor="#F0D48A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:fontFamily="serif" />
        <TextView
            android:id="@+id/chat"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/w_dark_pill"
            android:drawableStart="@drawable/w_ic_chat"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:paddingStart="7dp"
            android:paddingEnd="8dp"
            android:text="3"
            android:textColor="#F0D48A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/live_dot" />
            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROSSIMA SERATA"
                android:textColor="#C9A859"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />
        </LinearLayout>
        <TextView
            android:id="@+id/big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sab 5 dic · 21:00"
            android:textColor="#F8EBC4"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="4" />
        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="5/8 posti presi · Casa di Marco"
            android:textColor="#9FBFAE"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:scaleType="fitXY"
        android:src="@drawable/w_rule" />

    <LinearLayout
        android:id="@+id/money"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/owedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TI DEVONO" android:textColor="#C9A859" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.16" />
            <TextView android:id="@+id/owed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:text="€ 65,00" android:textColor="#6FE3A0" android:textSize="17sp" android:textStyle="bold" android:fontFamily="serif" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/oweBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DEVI" android:textColor="#C9A859" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.16" />
            <TextView android:id="@+id/owe" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:text="€ 0,00" android:textColor="#F8EBC4" android:textSize="17sp" android:textStyle="bold" android:fontFamily="serif" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/refresh"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="bottom|end"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="21:42"
                android:textColor="#C9A859"
                android:textSize="10sp" />
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
