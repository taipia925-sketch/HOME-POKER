<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w2_root"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- scheda rossa: come «CASSA LIVE» nell'app -->
    <FrameLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="74dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/w2_hero" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:adjustViewBounds="true"
            android:src="@drawable/w2_chips" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="96dp">
            <TextView
                android:id="@+id/kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="BURCIONE · 4 AL TAVOLO"
                android:textColor="#E0FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:fontFamily="@font/is_bold" />
            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="CASSA LIVE"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:fontFamily="@font/is_bold_italic"
                android:includeFontPadding="false"
                android:shadowColor="#66000000"
                android:shadowDy="2"
                android:shadowRadius="6" />
        </LinearLayout>
    </FrameLayout>

    <!-- montepremi: come la scheda della cassa -->
    <LinearLayout
        android:id="@+id/potBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/w2_wine"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Montepremi"
                    android:textColor="#A4B0A8"
                    android:textSize="12sp"
                    android:fontFamily="@font/is_regular" />
                <TextView
                    android:id="@+id/big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="140,00 €"
                    android:textColor="#F8ECCB"
                    android:textSize="32sp"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/bricolage_heavy" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/paid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incassato 80 €"
                    android:textColor="#46DA80"
                    android:textSize="12sp"
                    android:fontFamily="@font/is_bold" />
                <TextView
                    android:id="@+id/pend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Da pagare 60 €"
                    android:textColor="#FF5C50"
                    android:textSize="12sp"
                    android:fontFamily="@font/is_bold" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="9dp"
            android:max="100"
            android:progress="57"
            android:progressDrawable="@drawable/w2_bar" />
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Nessun giocatore al tavolo"
        android:textColor="#A4B0A8"
        android:textSize="13sp"
        android:fontFamily="@font/is_regular"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">
        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aggiornato alle 20:42"
            android:textColor="#7C8A82"
            android:textSize="11sp"
            android:fontFamily="@font/is_semibold" />
        <TextView
            android:id="@+id/undo"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/w2_gold_line"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Annulla"
            android:textColor="#FFD27A"
            android:textSize="12sp"
            android:fontFamily="@font/is_bold" />
        <TextView
            android:id="@+id/chat"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/w2_due"
            android:drawableStart="@drawable/w2_chat"
            android:drawablePadding="5dp"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="10dp"
            android:text="2 nuovi"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/is_bold" />
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:padding="6dp"
            android:src="@drawable/w2_refresh" />
    </LinearLayout>
</LinearLayout>
